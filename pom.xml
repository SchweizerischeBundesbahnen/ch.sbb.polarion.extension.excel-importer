<?xml version="1.0" encoding="UTF-8"?>
<project>
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.sbb.polarion.extensions</groupId>
        <artifactId>ch.sbb.polarion.extension.generic</artifactId>
        <version>16.4.0</version>
    </parent>

    <artifactId>ch.sbb.polarion.extension.excel-importer</artifactId>
    <version>6.3.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Polarion ALM extension to process WorkItems by uploading xlsx-files</name>
    <description>This Polarion extension provides possibility to update (or create) WorkItems using xlsx-file</description>
    <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.excel-importer</url>

    <licenses>
        <license>
            <name>The SBB License, Version 1.0</name>
            <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.excel-importer/blob/main/LICENSES/SBB.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>SBB Polarion Team</name>
            <email>polarion-opensource@sbb.ch</email>
            <organization>SBB AG</organization>
            <organizationUrl>https://www.sbb.ch</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.excel-importer.git</connection>
        <developerConnection>scm:git:ssh://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.excel-importer.git</developerConnection>
        <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.excel-importer/tree/main</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/SchweizerischeBundesbahnen/ch.sbb.polarion.extension.excel-importer/issues</url>
    </issueManagement>

    <properties>
        <maven-jar-plugin.Extension-Context>excel-importer</maven-jar-plugin.Extension-Context>
        <maven-jar-plugin.Automatic-Module-Name>ch.sbb.polarion.extension.excel_importer</maven-jar-plugin.Automatic-Module-Name>
        <maven-jar-plugin.Discover-Base-Package>ch.sbb.polarion.extension.excel_importer</maven-jar-plugin.Discover-Base-Package>

        <web.app.name>${maven-jar-plugin.Extension-Context}</web.app.name>

        <!-- Extension-specific Require-Bundle (in addition to common ones from parent POM):
            org.apache.commons.commons-collections4
            org.apache.commons.lang3
            org.jsoup
        -->
        <maven-jar-plugin.Require-Bundle.extension>org.apache.commons.commons-collections4,org.apache.commons.lang3,org.jsoup</maven-jar-plugin.Require-Bundle.extension>
        <maven-jar-plugin.Require-Bundle>${maven-jar-plugin.Require-Bundle.common},${maven-jar-plugin.Require-Bundle.extension}</maven-jar-plugin.Require-Bundle>

        <awaitility.version>4.3.0</awaitility.version>

        <!-- this extension is designed for latest version of Apache POI -->
        <apache-poi.version>6.0.0</apache-poi.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.sbb.polarion.extensions</groupId>
            <artifactId>ch.sbb.polarion.extension.generic.app</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${apache-poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${apache-poi.version}</version>
        </dependency>

        <dependency>
            <groupId>com.polarion.thirdparty</groupId>
            <artifactId>org.jsoup_1.21.2</artifactId>
            <version>${polarion.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.polarion.thirdparty</groupId>
            <artifactId>org.apache.commons.lang3_3.12.0</artifactId>
            <version>${polarion.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>ch.sbb.polarion.extensions</groupId>
            <artifactId>ch.sbb.polarion.extension.generic.app</artifactId>
            <version>${project.parent.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <!-- Everything markdown2html renders below (the parent only knows about.html);
                                 the same files .gitignore keeps out of git. -->
                            <directory>${markdown2html-maven-plugin.extensionContextAdminHtml}</directory>
                            <includes>
                                <include>*.html</include>
                            </includes>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <plugin>
                <groupId>ch.sbb.maven.plugins</groupId>
                <artifactId>markdown2html-maven-plugin</artifactId>
                <!--
                    Renders the About page (README.md) and the documentation-site articles of
                    ui/src/docs/docs.config.json into the app webapp's html/, which the app fetches them from.

                    The plugin-level configuration is shared by every execution: the parent's (failOnError,
                    generateHeadingIds, openExternalLinksInNewTab, its excludeChapters and removeLinesWithStrings)
                    plus the two below. An execution only names its input and output, and replaces the parent's
                    excludeChapters where it lists its own.

                    Every execution runs in generate-sources, one phase before the frontend build in
                    generate-resources: build-docs-index.mjs (npm `prebuild`) builds the documentation search
                    index from this very HTML, using the heading ids generateHeadingIds stamps on it, and fails
                    the build when an article is missing. An article added to the manifest needs an execution here.
                -->
                <configuration>
                    <!-- Keep relative links relative: the app's DocLinkInterceptor turns a link to another
                         article into in-app navigation, and any other one (docs/openapi.json) into a GitHub link.
                         combine.self=override is required: an empty element alone does not override the
                         parent's ${project.scm.url}, Maven keeps the inherited value on an empty merge. -->
                    <relativeLinkPrefix combine.self="override"/>
                    <!-- The articles are fetched as single files, so their images travel inside them. -->
                    <imageProcessingType>EMBED</imageProcessingType>
                </configuration>
                <executions>
                    <execution>
                        <id>readme.md-to-about.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                    </execution>
                    <!-- The documentation-site articles, in the reading order of ui/src/docs/docs.config.json. -->
                    <execution>
                        <id>quick_start.md-to-quick-start.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/QUICK_START.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/quick-start.html</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>user_guide.md-to-user-guide.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/USER_GUIDE.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/user-guide.html</outputFile>
                            <!-- The markdown keeps a Table of contents for GitHub; the sidebar and "On this page"
                                 of the documentation site provide that navigation, so drop it here. -->
                            <excludeChapters>
                                <excludeChapter>## Table of contents</excludeChapter>
                            </excludeChapters>
                        </configuration>
                    </execution>
                    <execution>
                        <id>rest_api.md-to-rest-api.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/REST_API.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/rest-api.html</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>velocity_functions.md-to-velocity-functions.html</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>convert</goal>
                        </goals>
                        <configuration>
                            <inputFile>${project.basedir}/VELOCITY_FUNCTIONS.md</inputFile>
                            <outputFile>${markdown2html-maven-plugin.extensionContextAdminHtml}/velocity-functions.html</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>

            <!-- Polarion 2606's JakartaCompatibilityChecker rejects a bundled jar only if a class makes a
                 real TYPE reference to a forbidden javax.* package. In POI's transitive xmlbeans, exactly
                 three SAAJ factory classes (MessageFactory, SOAPConnectionFactory, SOAPFactory) reference
                 javax.xml.soap; nothing else in xmlbeans references THEM and xlsx/OOXML never uses them.
                 Drop just those three from the bundled xmlbeans jar (keeping the rest — incl. impl.soap.Text,
                 which the xmlbeans core needs for XSSFWorkbook) so startup passes and xlsx still works.
                 Verified against the real checker (0/1032 flagged) + XSSFWorkbook round-trip. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>strip-xmlbeans-javax-soap-factories</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <pathconvert property="xmlbeans.lib">
                                    <fileset dir="${project.build.outputDirectory}/webapp/${web.app.name}/WEB-INF/lib" includes="xmlbeans-*.jar"/>
                                </pathconvert>
                                <zip destfile="${xmlbeans.lib}.stripped">
                                    <zipfileset src="${xmlbeans.lib}">
                                        <exclude name="org/apache/xmlbeans/impl/soap/MessageFactory.class"/>
                                        <exclude name="org/apache/xmlbeans/impl/soap/SOAPConnectionFactory.class"/>
                                        <exclude name="org/apache/xmlbeans/impl/soap/SOAPFactory.class"/>
                                    </zipfileset>
                                </zip>
                                <move file="${xmlbeans.lib}.stripped" tofile="${xmlbeans.lib}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-maven-plugin-jakarta</artifactId>
                <configuration>
                    <outputFormat>JSON</outputFormat>
                    <!-- Stable ordering, so a rebuild does not reshuffle docs/openapi.json. -->
                    <resourcePackages>
                        <package>ch.sbb.polarion.extension.generic.rest.controller.info</package>
                        <package>ch.sbb.polarion.extension.generic.rest.controller.settings</package>
                        <package>ch.sbb.polarion.extension.generic.rest.model</package>
                        <package>ch.sbb.polarion.extension.excel_importer.rest.controller</package>
                        <package>ch.sbb.polarion.extension.excel_importer.rest.model</package>
                    </resourcePackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.grigoriev</groupId>
                <artifactId>pre-commit-run-maven-plugin</artifactId>
            </plugin>

            <!-- Opts in to the compatibility check the generic parent pom declares. -->
            <plugin>
                <groupId>com.intechcore</groupId>
                <artifactId>polarion-compatibility-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
