<?xml version="1.0" encoding="UTF-8"?>
<module id="ch.sbb.polarion.extension.excel_importer" version="1.0.0">

    <contribution configuration-id="com.polarion.alm.wiki.renderingContext">
        <item key="excelTool" value="instance:ch.sbb.polarion.extension.excel_importer.ExcelTool" />
    </contribution>

    <!-- Classic Wiki Page -->
    <contribution configuration-id="com.polarion.alm.richpages.velocityContext">
        <item key="excelTool" value="instance:ch.sbb.polarion.extension.excel_importer.ExcelTool" />
    </contribution>

    <contribution configuration-id="com.polarion.xray.webui.administrationPageExtenders">
        <extender id="about"
                  name="About"
                  parentNodeId="excel-importer"
                  parentNodeName="Excel Importer"
                  parentNodeIconUrl="/polarion/excel-importer-app/ui/images/menu/30x30/_parent.svg"
                  iconUrl="/polarion/excel-importer-app/ui/images/menu/16x16/about.svg"
                  pageUrl="/polarion/excel-importer-app/ui/app/index.html?feature=about&amp;embedded=true&amp;scope=$scope$"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <!-- Single entry point to the documentation site (Quick Start, User Guide, REST API, Velocity
             Functions). It lands on Quick Start; the in-page sidebar navigates to the rest, so those
             articles need no menu entry of their own. -->
        <extender id="documentation"
                  name="Documentation"
                  parentNodeId="excel-importer"
                  parentNodeName="Excel Importer"
                  iconUrl="/polarion/excel-importer-app/ui/images/menu/16x16/user_guide.svg"
                  pageUrl="/polarion/excel-importer-app/ui/app/index.html?feature=quick-start&amp;embedded=true&amp;scope=$scope$"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="rest-api"
                  name="REST API"
                  parentNodeId="excel-importer"
                  iconUrl="/polarion/excel-importer-app/ui/images/menu/16x16/rest_api.svg"
                  pageUrl="/polarion/excel-importer/rest/swagger"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="mappings"
                  name="Mappings"
                  parentNodeId="excel-importer"
                  iconUrl="/polarion/excel-importer-app/ui/images/menu/16x16/mapping.svg"
                  pageUrl="/polarion/excel-importer-app/ui/app/index.html?feature=mappings&amp;embedded=true&amp;scope=$scope$"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="false"/>

        <extender id="import-file"
                  name="Import File"
                  parentNodeId="excel-importer"
                  iconUrl="/polarion/excel-importer-app/ui/images/menu/16x16/import.svg"
                  pageUrl="/polarion/excel-importer-app/ui/app/index.html?feature=import-file&amp;embedded=true&amp;scope=$scope$"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="false"/>
    </contribution>

    <contribution configuration-id="com.polarion.xray.webui.customNavigationExtenders">
        <extenders extender="excelImporterNavigationExtender"/>
    </contribution>

    <service-point id="excelImporterNavigationExtender" interface="com.polarion.alm.ui.server.navigation.NavigationExtender">
        <invoke-factory>
            <construct class="ch.sbb.polarion.extension.excel_importer.ExcelImporterNavigationExtender"/>
        </invoke-factory>
    </service-point>

</module>
